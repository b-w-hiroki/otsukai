{
  "rules": {
    ".read": false,
    ".write": false,
    "users": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid"
      }
    },
    "invites": {
      "$code": {
        ".read": "false",
        ".write": "false"
      }
    },
    "errors": {
      ".read": false,
      ".write": "auth != null"
    },
    "reminderIndex": {
      "$time": {
        "$familyId": {
          ".read": "auth != null",
          ".write": "auth != null && root.child('families/' + $familyId + '/members/' + auth.uid).exists()"
        }
      }
    },
    "families": {
      "$familyId": {
        ".read": "auth != null && data.child('members/' + auth.uid).exists()",
        ".write": "auth != null && ((!data.exists() && newData.child('meta/createdBy').val() === auth.uid && newData.child('members/' + auth.uid + '/role').val() === 'admin' && newData.child('members/' + auth.uid + '/memberRole').val() === 'parent') || (data.exists() && data.child('members/' + auth.uid + '/role').val() === 'admin'))",
        "members": {
          "$uid": {
            ".write": "auth != null && (root.child('families/' + $familyId + '/members/' + auth.uid + '/memberRole').val() === 'parent' || ($uid === auth.uid && data.exists() && newData.exists() && newData.child('role').val() === data.child('role').val() && newData.child('memberRole').val() === data.child('memberRole').val()))",
            "role": {
              ".validate": "newData.val() === data.val() || (!data.exists() && (($uid === auth.uid && !root.child('families/' + $familyId).exists() && newData.val() === 'admin') || newData.val() === 'member'))"
            }
          }
        },
        "requests": {
          ".write": "auth != null && root.child('families/' + $familyId + '/members/' + auth.uid).exists()"
        },
        "extraExpenses": {
          ".write": "auth != null && root.child('families/' + $familyId + '/members/' + auth.uid).exists()"
        },
        "comments": {
          ".write": "auth != null && root.child('families/' + $familyId + '/members/' + auth.uid).exists()"
        },
        "stats": {
          ".write": "auth != null && root.child('families/' + $familyId + '/members/' + auth.uid).exists()"
        },
        "shortcuts": {
          ".write": "auth != null && root.child('families/' + $familyId + '/members/' + auth.uid).exists()"
        },
        "destinations": {
          ".write": "auth != null && root.child('families/' + $familyId + '/members/' + auth.uid).exists()"
        },
        "stocks": {
          ".write": "auth != null && root.child('families/' + $familyId + '/members/' + auth.uid).exists()"
        },
        "missions": {
          ".write": "auth != null && root.child('families/' + $familyId + '/members/' + auth.uid).exists()"
        },
        "missionLogs": {
          ".write": "auth != null && root.child('families/' + $familyId + '/members/' + auth.uid).exists()"
        },
        "reminderTimes": {
          ".write": "auth != null && root.child('families/' + $familyId + '/members/' + auth.uid).exists()"
        },
        "settings": {
          ".write": "auth != null && root.child('families/' + $familyId + '/members/' + auth.uid).exists()",
          "lowLeadDays": {
            ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 60"
          }
        },
        "pushTokens": {
          ".write": "auth != null && root.child('families/' + $familyId + '/members/' + auth.uid).exists()"
        },
        "points": {
          "$uid": {
            ".write": "auth != null && (root.child('families/' + $familyId + '/members/' + auth.uid + '/memberRole').val() === 'parent' || ($uid === auth.uid && data.exists() && newData.exists() && newData.isNumber() && newData.val() >= 0 && newData.val() <= data.val()))"
          }
        },
        "rewards": {
          ".write": "auth != null && root.child('families/' + $familyId + '/members/' + auth.uid + '/memberRole').val() === 'parent'"
        },
        "rewardLogs": {
          "$logId": {
            ".write": "auth != null && !data.exists() && newData.exists() && newData.child('uid').val() === auth.uid && root.child('families/' + $familyId + '/members/' + auth.uid).exists()"
          }
        }
      }
    }
  }
}
